[Unit]
Description=ClinePass Manager Server
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=__ROOT__
ExecStart=__ROOT__/bin/server
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clinepass-manager

# Cloak / Chrome 会写 $HOME 和 XDG_RUNTIME_DIR。
# ProtectHome 会把 /root、/run/user 做成只读，必须指到项目 data 目录。
Environment=HOME=__ROOT__/data/home
Environment=DATA_DIR=__ROOT__/data
Environment=CLOAKBROWSER_CACHE_DIR=__ROOT__/data/cloakbrowser
Environment=XDG_RUNTIME_DIR=__ROOT__/data/run

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__ROOT__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

LimitNOFILE=65535
LimitNPROC=65535

[Install]
WantedBy=multi-user.target
