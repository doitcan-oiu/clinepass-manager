[Unit]
Description=ClinePass Manager Server
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=__ROOT__
ExecStart=__ROOT__/bin/server
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clinepass-manager

Environment=DATA_DIR=__ROOT__/data

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__ROOT__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

LimitNOFILE=65535
LimitNPROC=65535

[Install]
WantedBy=multi-user.target
